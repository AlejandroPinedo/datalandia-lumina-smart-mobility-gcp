# ==============================================================================
# PROYECTO DATALANDIA (LUMINA) - AVANCE 1 (P1): INGESTA Y STORAGE EN GCP
# ==============================================================================
GCP_PROJECT_ID=bigdata-herles-pinedo
GCP_REGION=us-central1
GCP_LOCATION=US

# --- Cloud Pub/Sub (Streaming: Array of Things IoT + Telemetría OART) ---
PUBSUB_TOPIC_IOT=lumina-iot-aot-telemetry-topic
PUBSUB_SUB_IOT=lumina-iot-aot-telemetry-sub

# --- Cloud Storage (Data Lake Raw / Landing & Dataflow Temp) ---
GCS_BUCKET_DATALAKE={GCP_PROJECT_ID}-lumina-datalake

# --- Google BigQuery (Arquitectura Medallion: Bronze, Silver, Gold, Audit) ---
BQ_DATASET_BRONZE=lumina_bronze_raw
BQ_DATASET_SILVER=lumina_silver_clean
BQ_DATASET_GOLD=lumina_gold_governed
BQ_DATASET_AUDIT=lumina_audit_dq

# --- Tablas Físicas de la Capa de Ingesta (Bronze) ---
BQ_TABLE_TLC_TRIPS=tlc_trips_raw
BQ_TABLE_UBER_SPEEDS=uber_movement_speeds_raw
BQ_TABLE_IOT_AOT=iot_aot_telemetry_raw
BQ_TABLE_CENSO_INE=censo_demografia_raw
BQ_TABLE_DEADLETTER=ingesta_deadletter_raw

# --- Parámetros de Apache Beam / Cloud Dataflow ---
DATAFLOW_RUNNER=DirectRunner
DATAFLOW_JOB_NAME=lumina-iot-aot-streaming-to-bq
STREAM_INTERVAL_SECONDS=0.3
STREAM_MAX_MESSAGES=30
ERROR_RATE_SIMULATION=0.15

# --- Credencial API Geocodificación (visto en Clase S4) ---
GEO_API_KEY=YOUR_GOOGLE_MAPS_GEOCODING_API_KEY
