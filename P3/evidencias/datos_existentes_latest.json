  "query_sql": "SELECT `transport_mode` AS transport_mode,COUNT(*) AS total_trips,\n      COUNT(DISTINCT `trip_id`) AS unique_trip_ids,\n      SUM(`trip_distance_km`) AS total_km,SUM(`lumina_total_fare_usd`) AS total_revenue_usd,\n      SAFE_DIVIDE(SUM(`lumina_total_fare_usd`),SUM(`trip_distance_km`)) AS revenue_per_km_usd,\n      AVG(`lumina_duration_min`) AS avg_duration_min,AVG(`passenger_count`) AS avg_passengers,\n      CAST(NULL AS INT64) AS traffic_matched_trips,CAST(NULL AS INT64) AS iot_matched_trips,\n      COUNTIF(`trip_distance_km` IS NULL) AS missing_distance_rows,\n      COUNTIF(`lumina_total_fare_usd` IS NULL) AS missing_amount_rows,\n      COUNTIF(`trip_distance_km` < 0) AS negative_distance_rows\n    FROM `bigdata-herles-pinedo.lumina_gold_governed.fact_movilidad_multimodal_gold` GROUP BY transport_mode ORDER BY transport_mode",
